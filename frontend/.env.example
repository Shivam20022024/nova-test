# NovaTest AI — frontend environment
#
# Copy to `.env` and fill in. Only VITE_-prefixed variables are readable by the
# app; Vite inlines them into the browser bundle, so NEVER put a service-role
# key, an OpenAI key, or a database URL in this file. Those belong to
# backend-node only.

# Base URL of the Node backend (backend-node). No trailing slash.
# Used for REST calls and for the Socket.IO live-execution stream.
VITE_API_BASE="http://127.0.0.1:8080"

# Supabase project — used for sign-in/sign-up and to mint the bearer token
# that backend-node verifies on every request.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
